{
  "name": "ai-digital-office-os",
  "private": true,
  "version": "1.4.0",
  "description": "AI Digital Office OS v1.4 — multi-tenant AI orchestration platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "domain-model:generate": "pnpm --filter @ai-office/domain-model run generate",
    "test:rls-adversarial": "tsx --test tests/rls-adversarial/**/*.test.ts",
    "test:acceptance": "tsx --test tests/acceptance/**/*.test.ts"
  },
  "dependencies": {
    "@ai-office/cost-usage-service": "workspace:*",
    "@ai-office/db": "workspace:*",
    "@ai-office/tool-gateway-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "js-yaml": "^5.4.1",
    "pg": "^8.12.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.6.0"
}
