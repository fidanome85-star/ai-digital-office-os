# Local development defaults — matches infra/docker/docker-compose.yml
# Owner role: runs migrations (bypasses RLS — never used by application services).
DATABASE_URL=postgres://ai_office:ai_office_dev_password@localhost:5432/ai_digital_office_os
# Application role: created by migration 0022, subject to RLS. Every service
# and every RLS test connects with THIS url, never the owner url above.
APP_DATABASE_URL=postgres://ai_office_app:ai_office_app_dev_password@localhost:5432/ai_digital_office_os

# packages/auth — JWT/JWKS verification
AUTH_JWT_ISSUER=https://auth.ai-digital-office-os.local/
AUTH_JWT_AUDIENCE=ai-digital-office-os-control-plane
AUTH_JWKS_URI=https://auth.ai-digital-office-os.local/.well-known/jwks.json
AUTH_CLOCK_TOLERANCE_SECONDS=30
